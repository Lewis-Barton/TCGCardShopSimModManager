<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TCGCardShopSimModManager.App.MainWindow"
        Title="TCG Card Shop Sim Mod Manager"
        Width="1280" Height="760" MinWidth="980" MinHeight="620">

  <Grid x:Name="_shellGrid" ColumnDefinitions="190,*">
    <Border Grid.Column="0" Background="{DynamicResource PanelBrush}"
            BorderBrush="{DynamicResource BorderBrushKey}" BorderThickness="0,0,1,0">
      <Grid Margin="14" RowDefinitions="Auto,*,Auto">
        <StackPanel Spacing="2" Margin="12,8,4,28">
          <TextBlock Classes="header" FontSize="16" TextWrapping="Wrap"
                     Text="TCG Card Shop Sim Mod Manager" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="8">
          <Button x:Name="_browseNav" Classes="nav active" Content="Browse modpacks"
                  HorizontalContentAlignment="Left" Click="OnBrowseNavClick" />
          <Button x:Name="_manageNav" Classes="nav" Content="Manage mods"
                  HorizontalContentAlignment="Left" Click="OnManageNavClick" />
          <Button x:Name="_settingsNav" Classes="nav" Content="Settings"
                  HorizontalContentAlignment="Left" Click="OnSettingsNavClick" />
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="8" Margin="4,0">
          <Button Content="Launch game" HorizontalContentAlignment="Center"
                  Click="OnLaunchGameClick" />
          <TextBlock Classes="subtitle" Text="TCG Card Shop Simulator" />
          <TextBlock x:Name="_versionText" Classes="subtitle" Text="Version" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1">
      <Grid x:Name="_browsePage" RowDefinitions="Auto,*">
        <Grid Grid.Row="0" Margin="22,18,22,14" ColumnDefinitions="*,Auto">
          <StackPanel Spacing="2">
            <TextBlock Classes="pageTitle" Text="Browse modpacks" />
            <TextBlock Classes="subtitle" Text="Find a curated setup and install it in one step." />
            <TextBlock x:Name="_installedPackSummary" FontWeight="SemiBold"
                       Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1" Content="Refresh" Click="OnRefreshPacksClick"
                  HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
        </Grid>

        <Grid x:Name="_browseLayout" Grid.Row="1" Margin="22,0,22,20" ColumnDefinitions="240,*">
          <Border Grid.Column="0" Classes="card filterPanel" Padding="14" Margin="0,0,14,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
              <StackPanel Spacing="12">
                <TextBox x:Name="_packSearch" Watermark="Search modpacks..."
                         TextChanged="OnPackTextFilterChanged" />
                <StackPanel Spacing="6">
                  <TextBlock FontWeight="SemiBold" Text="Include" />
                  <CheckBox x:Name="_includeNonFeatured" Content="Non-featured"
                            IsChecked="True" IsCheckedChanged="OnPackCheckFilterChanged" />
                  <CheckBox x:Name="_includeAdult" Content="NSFW" IsChecked="False"
                            IsCheckedChanged="OnPackCheckFilterChanged"
                            ToolTip.Tip="Show NSFW modpacks. Nexus account restrictions still apply to downloads." />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock FontWeight="SemiBold" Text="Maximum download size" />
                  <Slider x:Name="_sizeFilter" Minimum="0" Maximum="20" Value="20"
                          TickFrequency="1" ValueChanged="OnPackSizeFilterChanged" />
                  <TextBlock x:Name="_sizeFilterLabel" Classes="subtitle" Text="Any size" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock FontWeight="SemiBold" Text="Has mod" />
                    <CheckBox Grid.Column="1" x:Name="_excludeMod" Content="Exclude"
                              IsCheckedChanged="OnPackCheckFilterChanged" />
                  </Grid>
                  <TextBox x:Name="_modFilter" Watermark="Mod name or id"
                           TextChanged="OnPackTextFilterChanged" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock FontWeight="SemiBold" Text="Has tag" />
                  <TextBox x:Name="_tagFilter" Watermark="Tag"
                           TextChanged="OnPackTextFilterChanged" />
                </StackPanel>

                <CheckBox x:Name="_installedOnly" Content="Installed modpacks only"
                          IsCheckedChanged="OnPackCheckFilterChanged" />
                <Button Content="Reset filters" Classes="secondary" Click="OnResetFiltersClick" />
              </StackPanel>
            </ScrollViewer>
          </Border>

          <Grid Grid.Column="1" RowDefinitions="*,Auto,Auto">
            <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
              <WrapPanel x:Name="_packsPanel" Orientation="Horizontal" />
            </ScrollViewer>
            <ProgressBar Grid.Row="1" x:Name="_packProgress" IsIndeterminate="True"
                         IsVisible="False" Height="5" Margin="0,8,0,0" />
            <TextBlock Grid.Row="2" x:Name="_packStatus" Classes="subtitle"
                       Text="Loading modpacks..." Margin="2,8,0,0" />
          </Grid>
        </Grid>
      </Grid>

      <Grid x:Name="_managePage" IsVisible="False" Margin="22"
            RowDefinitions="Auto,Auto,Auto,Auto,*">
        <StackPanel Grid.Row="0" Spacing="2" Margin="0,0,0,14">
          <TextBlock Classes="pageTitle" Text="Manage mods" />
          <TextBlock Classes="subtitle" Text="Choose the game folder and manage installed mods." />
        </StackPanel>
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto">
          <TextBox x:Name="_gameBox" Watermark="Game folder" />
          <Button Grid.Column="1" Margin="8,0,0,0" Content="Browse..." Click="OnPickGameFolder" />
        </Grid>
        <StackPanel Grid.Row="2" Margin="0,10,0,0" Orientation="Horizontal" Spacing="8">
          <Button Content="Refresh list" Click="OnListModsClick" />
          <Button Content="Enable" Click="OnEnableClick" />
          <Button Content="Disable" Click="OnDisableClick" />
          <Button Content="Uninstall" Classes="danger" Click="OnUninstallClick" />
        </StackPanel>
        <ProgressBar Grid.Row="3" Margin="0,8,0,0" x:Name="_progress"
                     IsIndeterminate="True" IsVisible="False" Height="5" />
        <Grid Grid.Row="4" Margin="0,12,0,0" ColumnDefinitions="2*,*">
          <Border Classes="card" Margin="0,0,12,0">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Activity" Margin="0,0,0,8" />
              <TextBox x:Name="_log" IsReadOnly="True" AcceptsReturn="True"
                       TextWrapping="Wrap" FontFamily="Consolas" Text="TCG Card Shop Sim Mod Manager" />
            </DockPanel>
          </Border>
          <Border Grid.Column="1" Classes="card">
            <DockPanel>
              <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Text="Installed mods" Margin="0,0,0,8" />
              <ListBox x:Name="_modsList" />
            </DockPanel>
          </Border>
        </Grid>
      </Grid>

      <Grid x:Name="_settingsPage" IsVisible="False" Margin="22" RowDefinitions="Auto,*">
        <StackPanel Spacing="2">
          <TextBlock Classes="pageTitle" Text="Settings" />
          <TextBlock Classes="subtitle" Text="Application tools and maintenance." />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="12" MaxWidth="620" Margin="0,0,12,12"
                      HorizontalAlignment="Left" VerticalAlignment="Top">
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock FontWeight="SemiBold" Text="Appearance and accessibility" />
              <TextBlock Classes="subtitle" TextWrapping="Wrap"
                         Text="Choose a colour theme, text size and modpack card size. Changes apply immediately and are saved for the next launch." />
              <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto">
                <TextBlock VerticalAlignment="Center" Text="Colour theme" />
                <ComboBox Grid.Column="1" x:Name="_themeSelector"
                          SelectionChanged="OnAppearanceChanged" />
                <TextBlock Grid.Row="1" Margin="0,8,0,0" VerticalAlignment="Center" Text="Text size" />
                <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,8,0,0" x:Name="_textSizeSelector"
                          SelectionChanged="OnAppearanceChanged" />
                <TextBlock Grid.Row="2" Margin="0,8,0,0" VerticalAlignment="Center" Text="Modpack cards" />
                <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,8,0,0" x:Name="_cardSizeSelector"
                          SelectionChanged="OnAppearanceChanged" />
              </Grid>
              <TextBlock Classes="subtitle" TextWrapping="Wrap"
                         Text="High contrast and written status labels help when colour alone is difficult to distinguish." />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock FontWeight="SemiBold" Text="Nexus Mods account" />
              <TextBlock x:Name="_nexusStatus" TextWrapping="Wrap" Text="Checking sign-in status..." />
              <TextBlock Classes="subtitle" TextWrapping="Wrap"
                         Text="OAuth sign-in requires an approved Nexus client. While approval is pending, you can use a personal API key from your Nexus account." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Name="_nexusLogin" Content="Sign in to Nexus" Click="OnNexusLoginClick" />
                <Button x:Name="_nexusLogout" Content="Sign out" Classes="secondary"
                        Click="OnNexusLogoutClick" />
                <Button x:Name="_nexusApiKey" Content="Enter API key" Classes="secondary"
                        Click="OnNexusApiKeyClick" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock FontWeight="SemiBold" Text="Maintenance" />
              <TextBlock TextWrapping="Wrap" Text="Check for app updates or create a support bundle for troubleshooting." />
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Content="Check for updates" Click="OnUpdateCheckClick" />
                <Button x:Name="_exportSupportBundle" Content="Export support bundle"
                        Classes="secondary" Click="OnExportBundleClick" />
              </StackPanel>
              <TextBlock x:Name="_supportBundleStatus" Classes="subtitle"
                         TextWrapping="Wrap" IsVisible="False" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="10">
              <TextBlock FontWeight="SemiBold" Text="Modpack author tools" />
              <TextBlock FontWeight="SemiBold" TextWrapping="Wrap"
                         Text="For modpack authors only — people who only install modpacks do not need this tool." />
              <TextBlock Classes="subtitle" TextWrapping="Wrap"
                         Text="Check the hosted manifests against Nexus for newer, archived or missing pinned files. This is read-only: every suggested replacement must still be reviewed and tested before publishing." />
              <Button x:Name="_checkPackFiles" HorizontalAlignment="Left"
                      Content="Check pinned Nexus files" Click="OnCheckPackFilesClick" />
            </StackPanel>
          </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
